						Xil_Out16(exLbus, h); // row for horizontal line
						Xil_Out16(exRbus, (i << 7));	// diagonal line
						Xil_Out8(exWen, 1);	// write to BRAM
						Xil_Out8(exWen, 0);	// turn off write
					}
					break;
