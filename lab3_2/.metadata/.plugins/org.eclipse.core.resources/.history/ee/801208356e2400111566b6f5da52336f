/************************** Constant Definitions ****************************/

/*
 * The following constants define the slave registers used for our Counter PCORE
 */
#define countBase		0x44a00000
#define exWrAddr		countBase			// 10 LSBs of slv_reg0 BRAM address
#define	exWen			countBase+4			// 1  LSBs of slv_reg1 BRAM external write enable
#define	Lbus_out_s		countBase+8			// 16 LSBs of slv_reg2 Left sample bus from datapath
#define	Rbus_out_s		countBase+0xc		// 16 LSBs of slv_reg3 Right sample bus from datapath
#define exLbus			countBase+0x10		// 16 LSBs of slv_reg4 Left sample bus to datapath
#define exRbus			countBase+0x14		// 16 LSBs of slv_reg5 Right sample bus to datapath
#define flagQ_s 		countBase+0x18		// 1  LSBs of slv_reg6 Datapath interrupt for ublaze
#define flagClear		countBase+0x1c		// 1  LSBs of slv_reg7 Interrupt reset from ublaze to DP
#define trigger_v		countBase+0x20		// 11 LSBs of slv_reg8 Vertical trigger location
#define trigger_t		countBase+0x24		// 11 LSBs of slv_reg9 Horizontal trigger location

#define printf xil_printf			/* A smaller footprint printf */

#define	uartRegAddr			0x40600000		// read <= RX, write => TX

/************************** Function Prototypes ****************************/
void myISR(void);

