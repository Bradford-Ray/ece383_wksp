void write_SCCB(int subAddr, int data){
	Xil_Out8(sccbDataReg, data);
	Xil_Out8(sccbSubAddrReg, subAddr);

	// Wait for hardware to be IDLE
	while( (Xil_In8(sccbReadyReg) & 0x01) == 0 );

	// Trigger the start
	Xil_Out8(sccbEnReg, 1);

	// Wait for the VHDL to acknowledge the trigger
	while( (Xil_In8(sccbReadyReg) & 0x01) == 1 );

	// Turn off the trigger
	Xil_Out8(sccbEnReg, 0);

	// Wait for the transmission to finish before allowing another 'r' press
	while( (Xil_In8(sccbReadyReg) & 0x01) == 0 );
}
